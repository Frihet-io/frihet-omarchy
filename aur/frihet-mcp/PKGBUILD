# Maintainer: Frihet <hello@frihet.io>
pkgname=frihet-mcp
pkgver=2.0.2
pkgrel=1
pkgdesc="Official MCP server and terminal CLI for Frihet ERP on Arch Linux & Omarchy"
arch=('any')
url="https://github.com/Frihet-io/frihet-mcp"
license=('MIT')
depends=('nodejs>=20')
makedepends=('npm')
source=(
  "mcp-server-${pkgver}.tgz::https://registry.npmjs.org/@frihet/mcp-server/-/mcp-server-${pkgver}.tgz"
  'frihet-cli'
  'frihet-omarchy-setup'
)
noextract=("mcp-server-${pkgver}.tgz")
sha256sums=(
  'e8aac17728b17fec38a1890649d8cc05a1f7e6192f6b92e9f8b6dd4ad5f81977'
  '6831132bfdc252af91577e63219eb0e4142dc09211c08d4aa05574dacdfa8b3a'
  'b0bc3d8c9da9256f264086a87302ca8e2c8ba4ff409149752bc34ef152fccec0'
)

package() {
  npm install -g --cache "${srcdir}/npm-cache" --prefix "${pkgdir}/usr" "${srcdir}/mcp-server-${pkgver}.tgz"
  chown -R root:root "${pkgdir}"
  install -Dm755 "${srcdir}/frihet-cli" "${pkgdir}/usr/bin/frihet-cli"
  install -Dm755 "${srcdir}/frihet-omarchy-setup" "${pkgdir}/usr/bin/frihet-omarchy-setup"
}
