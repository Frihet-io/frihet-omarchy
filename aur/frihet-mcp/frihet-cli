#!/usr/bin/env node
"use strict";

(async function run() {
  const crypto = await import("node:crypto");
  const fs = await import("node:fs");
  const os = await import("node:os");
  const path = await import("node:path");

  const DEFAULT_API_BASE_URL = "https://api.frihet.io/v1";
  const REQUEST_TIMEOUT_MS = 10000;
  const MAX_RESPONSE_BYTES = 262144;

  function redactSecrets(text) {
    return String(text || "").replace(/fri_[A-Za-z0-9_-]+/g, "[REDACTED]");
  }

  class CliError extends Error {
    constructor(message, exitCode = 1) {
      super(redactSecrets(message));
      this.name = "CliError";
      this.exitCode = exitCode;
    }
  }

  function getDefaultEnvPath() {
    const configHome = process.env.XDG_CONFIG_HOME || path.join(os.homedir(), ".config");
    return path.join(configHome, "frihet", "env");
  }

  function parseEnvFile(filePath) {
    const result = {};
    if (!filePath || !fs.existsSync(filePath)) return result;
    const content = fs.readFileSync(filePath, "utf8");
    for (const rawLine of content.split(/\r?\n/)) {
      const line = rawLine.trim();
      if (!line || line.startsWith("#")) continue;
      const withoutExport = line.startsWith("export ") ? line.slice(7).trim() : line;
      const eqIndex = withoutExport.indexOf("=");
      if (eqIndex <= 0) continue;
      const key = withoutExport.slice(0, eqIndex).trim();
      let val = withoutExport.slice(eqIndex + 1).trim();
      if (
        (val.startsWith('"') && val.endsWith('"') && val.length >= 2) ||
        (val.startsWith("'") && val.endsWith("'") && val.length >= 2)
      ) {
        val = val.slice(1, -1);
      }
      result[key] = val;
    }
    return result;
  }

  function loadConfig() {
    const envPath = process.env.FRIHET_CONFIG_ENV || getDefaultEnvPath();
    const fileVars = parseEnvFile(envPath);
    const apiKey = (process.env.FRIHET_API_KEY || fileVars.FRIHET_API_KEY || "").trim();
    const apiUrl = (process.env.FRIHET_API_URL || fileVars.FRIHET_API_URL || DEFAULT_API_BASE_URL).trim();
    if (!apiKey) {
      throw new CliError("Frihet API key not configured. Run frihet-omarchy-setup first.", 1);
    }
    return { apiKey, apiUrl };
  }

  function validateSafeApiBaseUrl(rawUrl) {
    const candidate = String(rawUrl || DEFAULT_API_BASE_URL).trim().replace(/\/+$/, "");
    let parsed;
    try {
      parsed = new URL(candidate);
    } catch {
      throw new CliError("Invalid Frihet API base URL configured.", 2);
    }

    if (parsed.username || parsed.password) {
      throw new CliError("API base URL must not embed credentials.", 2);
    }

    const host = parsed.hostname.toLowerCase();
    const isLoopback = host === "127.0.0.1" || host === "localhost" || host === "::1" || host === "[::1]";
    const allowLoopback = process.env.FRIHET_ALLOW_LOOPBACK_TEST === "1";

    if (isLoopback) {
      if (!allowLoopback) {
        throw new CliError("Loopback API URL is disabled outside test mode.", 2);
      }
      if (parsed.protocol !== "http:" && parsed.protocol !== "https:") {
        throw new CliError("API base URL must use HTTP or HTTPS.", 2);
      }
      return candidate;
    }

    if (parsed.protocol !== "https:") {
      throw new CliError("Frihet API base URL must use HTTPS.", 2);
    }

    if (host !== "api.frihet.io" && !host.endsWith(".frihet.io")) {
      throw new CliError("Frihet API key can only be sent to *.frihet.io origins.", 2);
    }

    return candidate;
  }

  function currentLocalYearMonth() {
    const now = new Date();
    const year = String(now.getFullYear());
    const month = String(now.getMonth() + 1).padStart(2, "0");
    return `${year}-${month}`;
  }

  function currentLocalQuarter() {
    const now = new Date();
    const year = String(now.getFullYear());
    const q = Math.floor(now.getMonth() / 3) + 1;
    return `${year}-Q${q}`;
  }

  async function readBoundedText(res, maxBytes) {
    if (!res.body) return "";
    const reader = res.body.getReader();
    const chunks = [];
    let total = 0;

    while (true) {
      const { done, value } = await reader.read();
      if (done) break;
      if (value) {
        total += value.byteLength;
        if (total > maxBytes) {
          try {
            await reader.cancel();
          } catch {
            // ignore
          }
          throw new CliError(`API response exceeded ${maxBytes} byte limit.`);
        }
        chunks.push(Buffer.from(value));
      }
    }

    return Buffer.concat(chunks, total).toString("utf8");
  }

  async function apiRequest(method, url, apiKey, body, extraHeaders = {}) {
    const headers = {
      "X-API-Key": apiKey,
      "X-Frihet-Source": "omarchy-cli",
      "User-Agent": "frihet-omarchy-cli/1.0.0",
      "Accept": "application/json",
      ...extraHeaders
    };
    if (body !== undefined) {
      headers["Content-Type"] = "application/json";
    }

    let res;
    try {
      res = await fetch(url, {
        method,
        redirect: "manual",
        signal: AbortSignal.timeout(REQUEST_TIMEOUT_MS),
        headers,
        body: body !== undefined ? JSON.stringify(body) : undefined
      });
    } catch (err) {
      const msg = err && err.name === "TimeoutError"
        ? "Frihet API request timed out."
        : `Could not reach Frihet API: ${err && err.message ? err.message : "network error"}`;
      throw new CliError(msg);
    }

    if (res.status >= 300 && res.status < 400) {
      throw new CliError(`Refusing HTTP redirect (${res.status}) from API.`);
    }

    const text = await readBoundedText(res, MAX_RESPONSE_BYTES);
    let parsed = null;
    if (text.trim() !== "") {
      try {
        parsed = JSON.parse(text);
      } catch {
        if (res.ok) {
          throw new CliError("Frihet API returned invalid JSON.");
        }
      }
    }

    if (!res.ok) {
      const detail = parsed && typeof parsed === "object" ? (parsed.message || parsed.error || "") : "";
      throw new CliError(`Frihet API error (${res.status}): ${detail || "request failed"}`);
    }

    return parsed;
  }

  function unwrapObj(raw) {
    if (!raw || typeof raw !== "object") return {};
    if (raw.data && typeof raw.data === "object" && !Array.isArray(raw.data)) {
      return raw.data;
    }
    return raw;
  }

  function firstFinite(...values) {
    for (const v of values) {
      if (typeof v === "number" && Number.isFinite(v)) return v;
    }
    return null;
  }

  function fmtMoney(amount, currency) {
    if (typeof amount !== "number" || !Number.isFinite(amount)) return "N/A";
    const curr = String(currency || "EUR").trim().toUpperCase() || "EUR";
    return `${amount.toFixed(2)} ${curr}`;
  }

  function extractInvoices(raw) {
    if (Array.isArray(raw)) return raw;
    if (!raw || typeof raw !== "object") return [];
    if (Array.isArray(raw.data)) return raw.data;
    if (Array.isArray(raw.items)) return raw.items;
    if (Array.isArray(raw.invoices)) return raw.invoices;
    if (raw.data && typeof raw.data === "object") {
      if (Array.isArray(raw.data.items)) return raw.data.items;
      if (Array.isArray(raw.data.invoices)) return raw.data.invoices;
    }
    return [];
  }

  function printHelp() {
    process.stdout.write(
      [
        "frihet-cli - Terminal client for Frihet ERP (Omarchy / Arch Linux)",
        "",
        "Usage:",
        "  frihet-cli status [--json]",
        "  frihet-cli monthly [YYYY-MM] [--json]",
        "  frihet-cli quarterly [YYYY-QN] [--json]",
        "  frihet-cli invoices [--limit N] [--json]",
        "  frihet-cli draft-invoice --client-id <id> --description <text> --qty <n> --unit-price <n> [--tax-rate <n>] [--currency <ISO>] [--json]",
        "",
        "Safety invariant:",
        "  draft-invoice always creates invoices with status=\"draft\".",
        "  Fiscal submissions (VeriFactu/AEAT) require human confirmation in https://app.frihet.io.",
        ""
      ].join("\n")
    );
  }

  function parseFlags(args) {
    const positionals = [];
    const flags = {};
    for (let i = 0; i < args.length; i++) {
      const token = args[i];
      if (token === "--json" || token === "--help" || token === "-h" || token === "--version" || token === "-v") {
        flags[token.replace(/^-+/, "")] = true;
      } else if (token.startsWith("--")) {
        const eqIdx = token.indexOf("=");
        if (eqIdx > 2) {
          const key = token.slice(2, eqIdx);
          const val = token.slice(eqIdx + 1);
          flags[key] = val;
        } else {
          const key = token.slice(2);
          i++;
          if (i >= args.length) {
            throw new CliError(`Flag --${key} requires a value.`, 2);
          }
          flags[key] = args[i];
        }
      } else {
        positionals.push(token);
      }
    }
    return { positionals, flags };
  }

  async function handleStatus(safeBaseUrl, apiKey, asJson) {
    const month = currentLocalYearMonth();
    const [ctxRaw, monthlyRaw] = await Promise.all([
      apiRequest("GET", `${safeBaseUrl}/context`, apiKey),
      apiRequest("GET", `${safeBaseUrl}/monthly?month=${encodeURIComponent(month)}`, apiKey)
    ]);
    const ctx = unwrapObj(ctxRaw);
    const monthly = unwrapObj(monthlyRaw);

    if (asJson) {
      process.stdout.write(`${JSON.stringify({ period: month, context: ctx, monthly }, null, 2)}\n`);
      return;
    }

    const workspace = String(ctx.workspaceName || ctx.businessName || ctx.name || "Frihet ERP");
    const currency = String(ctx.currency || monthly.currency || "EUR").toUpperCase();
    const rev = firstFinite(monthly.revenue && monthly.revenue.total, monthly.revenueTotal);
    const exp = firstFinite(monthly.expenses && monthly.expenses.total, monthly.expensesTotal);
    const net = firstFinite(monthly.profit && monthly.profit.net, monthly.netProfit);
    const vat = firstFinite(
      monthly.taxLiability && monthly.taxLiability.vatPayable,
      monthly.taxLiability && monthly.taxLiability.estimatedModel303,
      monthly.vatPayable
    );
    const inv = monthly.invoices || monthly.counts || {};

    process.stdout.write(
      [
        `Workspace: ${workspace}`,
        `Period:    ${month}`,
        `Revenue:   ${fmtMoney(rev, currency)}`,
        `Expenses:  ${fmtMoney(exp, currency)}`,
        `Net:       ${fmtMoney(net, currency)}`,
        `VAT Est.:  ${fmtMoney(vat, currency)}`,
        `Invoices:  paid=${inv.paid ?? 0} sent=${inv.sent ?? 0} overdue=${inv.overdue ?? 0} draft=${inv.draft ?? 0}`,
        ""
      ].join("\n")
    );
  }

  async function handleMonthly(safeBaseUrl, apiKey, monthArg, asJson) {
    const month = monthArg || currentLocalYearMonth();
    if (!/^\d{4}-(0[1-9]|1[0-2])$/.test(month)) {
      throw new CliError("Invalid month format. Expected YYYY-MM (for example 2026-11).", 2);
    }
    const raw = await apiRequest("GET", `${safeBaseUrl}/monthly?month=${encodeURIComponent(month)}`, apiKey);
    const monthly = unwrapObj(raw);

    if (asJson) {
      process.stdout.write(`${JSON.stringify(monthly, null, 2)}\n`);
      return;
    }

    const currency = String(monthly.currency || "EUR").toUpperCase();
    const rev = firstFinite(monthly.revenue && monthly.revenue.total, monthly.revenueTotal);
    const exp = firstFinite(monthly.expenses && monthly.expenses.total, monthly.expensesTotal);
    const net = firstFinite(monthly.profit && monthly.profit.net, monthly.netProfit);
    const vat = firstFinite(
      monthly.taxLiability && monthly.taxLiability.vatPayable,
      monthly.taxLiability && monthly.taxLiability.estimatedModel303,
      monthly.vatPayable
    );

    process.stdout.write(
      [
        `Monthly Summary (${month})`,
        `Revenue:   ${fmtMoney(rev, currency)}`,
        `Expenses:  ${fmtMoney(exp, currency)}`,
        `Net:       ${fmtMoney(net, currency)}`,
        `VAT Est.:  ${fmtMoney(vat, currency)}`,
        ""
      ].join("\n")
    );
  }

  async function handleQuarterly(safeBaseUrl, apiKey, quarterArg, asJson) {
    const quarter = quarterArg || currentLocalQuarter();
    if (!/^\d{4}-Q[1-4]$/.test(quarter)) {
      throw new CliError("Invalid quarter format. Expected YYYY-QN (for example 2026-Q4).", 2);
    }
    const raw = await apiRequest("GET", `${safeBaseUrl}/quarterly?quarter=${encodeURIComponent(quarter)}`, apiKey);
    const q = unwrapObj(raw);

    if (asJson) {
      process.stdout.write(`${JSON.stringify(q, null, 2)}\n`);
      return;
    }

    const currency = String(q.currency || "EUR").toUpperCase();
    const m303 = q.modelo303 || {};
    const m130 = q.modelo130 || {};

    process.stdout.write(
      [
        `Quarterly Taxes (${q.quarter || quarter})`,
        `Modelo 303 Result: ${fmtMoney(firstFinite(m303.resultado, q.vatPayable), currency)}`,
        `Modelo 130 Tax:    ${fmtMoney(firstFinite(m130.pagoFraccionado, q.irpfPayable), currency)}`,
        ""
      ].join("\n")
    );
  }

  async function handleInvoices(safeBaseUrl, apiKey, limitArg, asJson) {
    let limit = 10;
    if (limitArg !== undefined) {
      const parsed = Number(limitArg);
      if (!Number.isInteger(parsed) || parsed < 1 || parsed > 100) {
        throw new CliError("--limit must be an integer between 1 and 100.", 2);
      }
      limit = parsed;
    }

    const raw = await apiRequest("GET", `${safeBaseUrl}/invoices?limit=${limit}`, apiKey);
    const items = extractInvoices(raw);

    const currencies = new Set();
    let sum = 0;
    let unavailableCount = 0;

    for (const inv of items) {
      const curr = String(inv && inv.currency ? inv.currency : "EUR").trim().toUpperCase() || "EUR";
      currencies.add(curr);
      const amt = firstFinite(inv && inv.total, inv && inv.amount);
      if (amt === null) {
        unavailableCount++;
      } else {
        sum += amt;
      }
    }

    const summary = {
      count: items.length,
      currency: currencies.size > 1 ? "MIXED" : (currencies.values().next().value || "EUR"),
      totalAmount: currencies.size > 1 || unavailableCount > 0 ? null : Number(sum.toFixed(2)),
      unavailableCount
    };

    if (asJson) {
      process.stdout.write(`${JSON.stringify({ summary, items }, null, 2)}\n`);
      return;
    }

    if (items.length === 0) {
      process.stdout.write("No invoices found.\n");
      return;
    }

    for (const inv of items) {
      const num = String(inv.invoiceNumber || inv.documentNumber || inv.number || inv.id || "-");
      const client = String(inv.clientName || inv.counterpartyName || (inv.client && inv.client.name) || "Client");
      const status = String(inv.status || "unknown");
      const curr = String(inv.currency || "EUR").toUpperCase();
      const amt = firstFinite(inv.total, inv.amount);
      process.stdout.write(`${num} | ${client} | ${fmtMoney(amt, curr)} | ${status}\n`);
    }

    if (summary.currency === "MIXED") {
      process.stdout.write(`Sample total: MIXED (${items.length} invoices across multiple currencies)\n`);
    } else if (summary.totalAmount === null) {
      process.stdout.write(`Sample total: N/A (${unavailableCount} invoice(s) missing total)\n`);
    } else {
      process.stdout.write(`Sample total (${items.length} invoices): ${fmtMoney(summary.totalAmount, summary.currency)}\n`);
    }
  }

  async function handleDraftInvoice(safeBaseUrl, apiKey, flags, asJson) {
    if (flags.status !== undefined && String(flags.status).trim().toLowerCase() !== "draft") {
      throw new CliError("Refusing non-draft status: agent/CLI invoice creation is strictly draft-only.", 2);
    }

    const clientId = String(flags["client-id"] || "").trim();
    const description = String(flags.description || "").trim();
    const qty = Number(flags.qty);
    const unitPrice = Number(flags["unit-price"]);

    if (!clientId) {
      throw new CliError("--client-id is required.", 2);
    }
    if (!description) {
      throw new CliError("--description is required.", 2);
    }
    if (!Number.isFinite(qty) || qty <= 0) {
      throw new CliError("--qty must be a finite number greater than 0.", 2);
    }
    if (!Number.isFinite(unitPrice) || unitPrice < 0) {
      throw new CliError("--unit-price must be a finite number >= 0.", 2);
    }

    const item = {
      description,
      quantity: qty,
      unitPrice
    };

    if (flags["tax-rate"] !== undefined) {
      const taxRate = Number(flags["tax-rate"]);
      if (!Number.isFinite(taxRate) || taxRate < 0 || taxRate > 100) {
        throw new CliError("--tax-rate must be between 0 and 100.", 2);
      }
      item.taxRate = taxRate;
    }

    const payload = {
      clientId,
      status: "draft",
      items: [item]
    };

    if (flags.currency !== undefined) {
      const currency = String(flags.currency).trim().toUpperCase();
      if (!/^[A-Z]{3}$/.test(currency)) {
        throw new CliError("--currency must be a 3-letter ISO code (for example EUR).", 2);
      }
      payload.currency = currency;
    }

    const idempotencyKey = `idemp_${crypto.randomUUID()}`;
    const raw = await apiRequest(
      "POST",
      `${safeBaseUrl}/invoices`,
      apiKey,
      payload,
      { "Idempotency-Key": idempotencyKey }
    );
    const created = unwrapObj(raw);
    const id = String(created.id || "");
    const confirmUrl = id ? `https://app.frihet.io/invoices/${encodeURIComponent(id)}` : "https://app.frihet.io/invoices";

    if (asJson) {
      process.stdout.write(
        `${JSON.stringify({ id, status: "draft", idempotencyKey, confirmUrl, invoice: created }, null, 2)}\n`
      );
      return;
    }

    process.stdout.write(
      [
        `Created draft invoice: ${id || "(pending id)"}`,
        "Status: draft (non-fiscal until confirmed by human in Frihet ERP)",
        `Review & finalize: ${confirmUrl}`,
        ""
      ].join("\n")
    );
  }

  async function main() {
    const argv = process.argv.slice(2);
    const { positionals, flags } = parseFlags(argv);

    if (flags.version || flags.v) {
      process.stdout.write("frihet-cli 1.0.0\n");
      return;
    }

    const cmd = positionals[0];
    if (!cmd || flags.help || flags.h || cmd === "help") {
      printHelp();
      return;
    }

    const { apiKey, apiUrl } = loadConfig();
    const safeBaseUrl = validateSafeApiBaseUrl(apiUrl);
    const asJson = Boolean(flags.json);

    if (cmd === "status") {
      await handleStatus(safeBaseUrl, apiKey, asJson);
    } else if (cmd === "monthly") {
      await handleMonthly(safeBaseUrl, apiKey, positionals[1], asJson);
    } else if (cmd === "quarterly") {
      await handleQuarterly(safeBaseUrl, apiKey, positionals[1], asJson);
    } else if (cmd === "invoices") {
      await handleInvoices(safeBaseUrl, apiKey, flags.limit, asJson);
    } else if (cmd === "draft-invoice") {
      await handleDraftInvoice(safeBaseUrl, apiKey, flags, asJson);
    } else {
      throw new CliError(`Unknown command: ${cmd}. Run frihet-cli --help.`, 2);
    }
  }

  try {
    await main();
  } catch (err) {
    const code = err instanceof CliError ? err.exitCode : 1;
    process.stderr.write(`Error: ${redactSecrets(err && err.message ? err.message : "Command failed")}\n`);
    process.exit(code);
  }
})();
