# Maintainer: Frihet <hello@frihet.io>
pkgname=frihet-webapp
pkgver=1.0.0
pkgrel=1
pkgdesc="Frameless Wayland desktop web application launcher for Frihet ERP (Omarchy & Hyprland ready)"
arch=('any')
url="https://frihet.io"
license=('MIT')
depends=('xdg-utils' 'hicolor-icon-theme')
optdepends=('chromium: frameless --app window support when outside Omarchy')
source=(
  'frihet-erp-webapp'
  'frihet-erp.desktop'
  'frihet-mark-ink.svg'
  'frihet-mark-white.svg'
  'frihet-erp.png'
)
sha256sums=(
  '6208dce3657c46b5df4baf5adc99aab769c5990df4536a1a85bc9d94f3b84700'
  '5550d80ad72087928d686917bc86b05501fe0548aca484e7b790992184071a96'
  '05df4b5d16b9fe50e82487a77323181c3d2858585da62ae6e7f1340dff793c3a'
  '89e3fa3bdc67a1da5d50670c5e311e253cdaf7497a29211bf58477b0fbf3a2f5'
  '3d89937460eefab99625c679360daecfb3b5ffa68586f82aebc86a5cbe9cc24a'
)

package() {
  install -Dm755 "${srcdir}/frihet-erp-webapp" "${pkgdir}/usr/bin/frihet-erp-webapp"
  install -Dm644 "${srcdir}/frihet-erp.desktop" "${pkgdir}/usr/share/applications/frihet-erp.desktop"
  install -Dm644 "${srcdir}/frihet-erp.png" "${pkgdir}/usr/share/icons/hicolor/256x256/apps/frihet-erp.png"
  install -Dm644 "${srcdir}/frihet-mark-ink.svg" "${pkgdir}/usr/share/icons/hicolor/scalable/apps/frihet-erp.svg"
  install -Dm644 "${srcdir}/frihet-mark-white.svg" "${pkgdir}/usr/share/icons/hicolor/scalable/apps/frihet-erp-symbolic.svg"
}
